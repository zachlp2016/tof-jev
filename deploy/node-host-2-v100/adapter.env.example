# Copy to an untracked .env on the adapter host and supply both secrets.
# The adapter is CPU-only; Laya remains the separate systemd GPU service.
# Empty values keep this template fail-closed if it is copied without editing.
TOF_API_KEYS=[]
TOF_DEFAULT_BACKEND=laya
TOF_LAYA_BASE_URL=http://192.168.10.207:8084
TOF_LAYA_API_KEY=
TOF_LAYA_MODEL=english
# Record the exact authenticated /health revision before enabling consumers.
# TOF_LAYA_MODEL_REVISION=REPLACE_WITH_THE_ENGLISH_CHECKPOINT_REVISION
TOF_REQUEST_TIMEOUT_SECONDS=90
TOF_MAX_CONCURRENT_REQUESTS=8
TOF_MAX_INFLIGHT_REQUESTS=64
TOF_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","tof-prediction-adapter"]
TOF_ALLOWED_ORIGINS=[]
TOF_ENABLE_HOSTED=false
TOF_DOCKER_NETWORK=tof-prediction
