# Copy to .env for a real backend, then set a randomly generated API key.
# .env is a local secret file; do not commit it.
# This deliberately empty list prevents production startup until configured.
TOF_API_KEYS=[]
TOF_PORT=8080
TOF_DEFAULT_BACKEND=laya
TOF_LAYA_BASE_URL=http://laya-inference:8080
TOF_LAYA_API_KEY=
TOF_JEV_BASE_URL=https://api.typesafe.ai
TOF_JEV_API_KEY=
TOF_ENABLE_HOSTED=false
TOF_DOCKER_NETWORK=tof-prediction

# Optional adapter settings. Compose loads these from .env automatically.
TOF_JEV_MODEL=jev-1.13.0
TOF_REQUEST_TIMEOUT_SECONDS=30
TOF_MAX_CONCURRENT_REQUESTS=4
TOF_MAX_INFLIGHT_REQUESTS=64
TOF_BODY_TIMEOUT_SECONDS=10
TOF_MAX_BODY_BYTES=262144
TOF_MAX_RESPONSE_BYTES=1048576
TOF_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","tof-prediction-adapter"]
TOF_ALLOWED_ORIGINS=[]
# Set model identity when the local backend is installed and its version is known:
# TOF_LAYA_MODEL=your-model-name
# TOF_LAYA_MODEL_REVISION=your-exact-model-revision

# No backend is required for the explicit compose.dev.yaml mock override.
# Never reuse its public development key for real data or an exposed service.
